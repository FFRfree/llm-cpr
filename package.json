{
  "name": "llm-cpr-monorepo",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "LLM 订阅路由网关 monorepo：core=引擎（路由+管理面+看板分发）、dashboard=看板页面源码、cli=唯一 npm 发布包（发布时装配前两者）",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node packages/core/core/main.ts",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit",
    "build": "npm run build --workspaces --if-present",
    "vendor": "npm run vendor -w @ffrfree/llm-cpr"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
