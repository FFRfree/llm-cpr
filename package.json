{
  "name": "llm-cpr-monorepo",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "LLM 订阅路由网关 monorepo：core=引擎（路由+管理面+看板分发）、dashboard=看板页面源码、cli=唯一 npm 发布包（发布时装配前两者）",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "start": "node packages/core/core/main.ts",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit",
    "build": "pnpm -r --if-present build",
    "vendor": "pnpm --filter @ffrfree/llm-cpr vendor"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
