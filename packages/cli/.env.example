# llm-cpr 环境变量示例 —— 只放键名，不放真实值。
# 生产实际生效的 .env 在 /root/.config/coding-plan-router/.env（chmod 600），不在本仓。
# 本仓仅供开发/测试：cp .env.example .env 后填本地值；.env 已被 .gitignore 排除。
CPR_MASTER_KEY=
# OCG 直连订阅 key（config.json 里 backends[].key_env 引用的就是这些键名）
OPENCODE_GO_KEY_FOXMAIL=
OPENCODE_GO_KEY_GMAIL=
# CommandCode（CCG）订阅 key
COMMANDCODE_API_KEY=
